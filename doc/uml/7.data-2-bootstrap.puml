title Andexor Grass Spider (AGS)\nGet Domain Registration Data\nAGS RDAP Bootstrap Service\nData Diagrams

' Colors defined by Andexor Network Design System

!$ANDEXOR_BLUE_50  = "#F3F7FC"
!$ANDEXOR_BLUE_100 = "#E7EFF8"
!$ANDEXOR_BLUE_200 = "#C5D8EF"
!$ANDEXOR_BLUE_300 = "#8FB6E2"
!$ANDEXOR_BLUE_400 = "#4A8BD0"
!$ANDEXOR_BLUE_500 = "#1A5FA8"

!$OLD_GOLD_300 = "#F8D066"
!$OLD_GOLD_500 = "#EAAA00"

hide empty members
skinparam dpi 300

<style>

root {
    BackgroundColor $ANDEXOR_BLUE_200
    LineColor $ANDEXOR_BLUE_400
    LineThickness 4
    Margin 20
    RoundCorner 20
    Shadowing 1
}

title {
    BackgroundColor $ANDEXOR_BLUE_500
    FontColor $ANDEXOR_BLUE_50
    Margin 20
    Padding 20
}

map {
    BackgroundColor $ANDEXOR_BLUE_400
    HorizontalAlignment left
    LineColor $ANDEXOR_BLUE_500
}

footer {
    FontColor $ANDEXOR_BLUE_500
    FontStyle bold
    LineColor $ANDEXOR_BLUE_200
}

</style>

map GetDomainDataBootstrapRequest {
    id => ABCDEF
    event_ts => 2026-10-01T00:00:00Z
    trace_id => 41928b92edf1cdbe0ba6594baee5ae9
    span_id => 4f3a7b2e1c9d8e5f
    domain => andexor.net
    source => REST
}

map GetDomainDataBootstrapResponse {
    id => ABCDEF
    event_ts => 2026-10-01T00:00:00Z
    trace_id => 41928b92edf1cdbe0ba6594baee5ae9
    span_id => 4f3a7b2e1c9d8e5f
    domain => andexor.net
    url => https://...
    process_status => BOOTSTRAP_OK
}

