' Copyright 2026 Andexor Network, Inc.
' Author: Ed Jenkins<ed@andexor.net>

title Andexor Grass Spider (AGS)\nGet Domain Registration Data\nDeployment Diagram

' Colors defined by Andexor Network Design System

!$ANDEXOR_BLUE_50  = "#F3F7FC"
!$ANDEXOR_BLUE_100 = "#E7EFF8"
!$ANDEXOR_BLUE_200 = "#C5D8EF"
!$ANDEXOR_BLUE_300 = "#8FB6E2"
!$ANDEXOR_BLUE_400 = "#4A8BD0"
!$ANDEXOR_BLUE_500 = "#1A5FA8"

!$OLD_GOLD_300 = "#F8D066"
!$OLD_GOLD_500 = "#EAAA00"

hide stereotype
skinparam actorStyle awesome
skinparam dpi 300

<style>

root {
    BackgroundColor $ANDEXOR_BLUE_200
    LineColor $ANDEXOR_BLUE_500
    LineThickness 4
    Margin 20
    RoundCorner 20
    Shadowing 1
}

title {
    BackgroundColor $ANDEXOR_BLUE_500
    FontColor $ANDEXOR_BLUE_50
    LineColor $ANDEXOR_BLUE_400
    Margin 20
    Padding 20
}

arrow {
    FontColor $ANDEXOR_BLUE_500
    FontStyle bold
}

agent, component, database {
    BackgroundColor $ANDEXOR_BLUE_300
    FontColor $ANDEXOR_BLUE_500
    FontStyle bold
    LineColor $ANDEXOR_BLUE_500
}

footer {
    FontColor $ANDEXOR_BLUE_500
    FontStyle bold
    LineColor $ANDEXOR_BLUE_200
}

</style>

agent "ags-rdap-agent" as Agent
database "ags-rdap-agent-db" as AgentDB
Agent -- AgentDB

component "ags-rdap-bootstrap-service" as BootstrapService
database "ags-rdap-bootstrap-service-db" as BootstrapServiceDB
BootstrapService -- BootstrapServiceDB

component "ags-rdap-authoritative-service" as AuthoritativeService
database "ags-rdap-authoritative-service-db" as AuthoritativeServiceDB
AuthoritativeService -- AuthoritativeServiceDB

footer Copyright 2026 Andexor Network, Inc.

@enduml
